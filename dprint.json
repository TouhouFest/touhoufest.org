{
  "incremental": true,
  "markdown": {
    "textWrap": "always",
    "lineWidth": 100
  },
  "yaml": {
    "indentWidth": 2
  },
  "plugins": [
    "https://plugins.dprint.dev/json-0.20.0.wasm",
    "https://plugins.dprint.dev/markdown-0.18.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ],
  "includes": [
    "**/*.{md,yml,yaml,json}"
  ],
  "excludes": [
    "public",
    "node_modules",
    "static/processed_images",
    "AGENTS.md"
  ]
}
